//@version=5
// =====================================================================
// SHAHEEN  -  Support / Resistance by touch strength
// Paste into TradingView: Pine Editor -> paste -> Add to chart.
//
// It finds swing highs and lows, groups the ones sitting at the same price
// into a single LEVEL, and counts how many times price has reversed there.
// The more reversals a level has survived, the stronger it is - a line the
// market has respected 5 or 10 times matters more than a one-off wick.
//
//   green line  = support    (level at/below current price)
//   red line    = resistance (level above current price)
//   width/style = strength: thin dashed (weak) -> thick solid (major)
//   label       = "S x7 STRONG +MA" : side, touch count, tier, and any
//                 confluence (near the 50/200 MA, a round number, or tested
//                 on heavy volume)
//
// No buy price is drawn - that formula is not trusted yet, on purpose.
// =====================================================================
indicator("Shaheen S/R (touch strength)", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ---- inputs ----------------------------------------------------------
grpD   = "Detection"
piv    = input.int(10, "Swing strength (bars each side)", minval = 2, group = grpD)
tolMlt = input.float(0.6, "Merge tolerance (x ATR)", minval = 0.1, step = 0.1,
     group = grpD, tooltip = "Swings within this distance count as the same level")
minShow = input.int(2, "Min touches to draw a level", minval = 1, group = grpD)
maxShow = input.int(12, "Max levels to show", minval = 2, group = grpD)

grpS   = "Strength tiers (touches = reversals)"
strongN = input.int(5,  "STRONG at N touches", minval = 2, group = grpS)
majorN  = input.int(11, "MAJOR at N touches",  minval = 3, group = grpS)

grpC   = "Confluences"
showMA   = input.bool(true, "Plot 50 / 200 MA (dynamic S/R)", group = grpC)
useMA    = input.bool(true, "Tag levels near a 50/200 MA (+MA)", group = grpC)
useRound = input.bool(true, "Tag round-number levels (+round)", group = grpC)
useVol   = input.bool(true, "Tag levels tested on heavy volume (+vol)", group = grpC)

grpK   = "Colors"
cSup = input.color(color.new(color.green, 0), "Support", group = grpK)
cRes = input.color(color.new(color.red, 0),   "Resistance", group = grpK)

// ---- per-bar context (must be called every bar) ----------------------
atr    = ta.atr(14)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
volAvg = ta.sma(volume, 20)

// ---- level store (persists across bars) ------------------------------
var float[] lvlP = array.new_float()      // level price (running mean of touches)
var int[]   lvlT = array.new_int()        // touch / reversal count
var int[]   lvlB = array.new_int()        // bar index of last touch
var bool[]  lvlV = array.new_bool()       // ever tested on heavy volume
var int[]   order = array.new_int()       // draw order scratch (reused each bar)

// add a swing to the store, merging into a nearby level if one exists.
// Everything it needs is passed in, so it never reaches into global state.
addTouch(pP, pT, pB, pV, float p, bool heavy, float tol, int bidx) =>
    merged = false
    if array.size(pP) > 0
        for i = 0 to array.size(pP) - 1
            if math.abs(array.get(pP, i) - p) <= tol
                n = array.get(pT, i)
                array.set(pP, i, (array.get(pP, i) * n + p) / (n + 1))
                array.set(pT, i, n + 1)
                array.set(pB, i, bidx)
                if heavy
                    array.set(pV, i, true)
                merged := true
                break
    if not merged
        array.push(pP, p)
        array.push(pT, 1)
        array.push(pB, bidx)
        array.push(pV, heavy)

// drop the weakest levels when the store grows too large
prune(pP, pT, pB, pV) =>
    while array.size(pP) > 60
        w = 0
        for i = 1 to array.size(pT) - 1
            if array.get(pT, i) < array.get(pT, w)
                w := i
        array.remove(pP, w)
        array.remove(pT, w)
        array.remove(pB, w)
        array.remove(pV, w)

isRound(float p, float tol) =>
    step = p < 10 ? 0.5 : p < 100 ? 5.0 : p < 1000 ? 10.0 : 50.0
    math.abs(p - math.round(p / step) * step) <= tol

// confirmed swings (value is `piv` bars back)
tol = atr * tolMlt
ph = ta.pivothigh(high, piv, piv)
pl = ta.pivotlow(low, piv, piv)
heavyNow = volume > volAvg * 1.5
if not na(ph)
    addTouch(lvlP, lvlT, lvlB, lvlV, ph, heavyNow, tol, bar_index)
if not na(pl)
    addTouch(lvlP, lvlT, lvlB, lvlV, pl, heavyNow, tol, bar_index)
prune(lvlP, lvlT, lvlB, lvlV)

// ---- draw on the last bar only (clean redraw each time) --------------
var line[]  lns = array.new_line()
var label[] lbs = array.new_label()

if barstate.islast
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
    array.clear(lns)
    array.clear(lbs)

    // collect indices that clear minShow, then sort by touches (desc)
    array.clear(order)
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            if array.get(lvlT, i) >= minShow
                array.push(order, i)
    if array.size(order) > 1
        for a = 1 to array.size(order) - 1
            key = array.get(order, a)
            b = a - 1
            while b >= 0 and array.get(lvlT, array.get(order, b)) < array.get(lvlT, key)
                array.set(order, b + 1, array.get(order, b))
                b := b - 1
            array.set(order, b + 1, key)

    lim = math.min(maxShow, array.size(order))
    if lim > 0
        for j = 0 to lim - 1
            i = array.get(order, j)
            p = array.get(lvlP, i)
            tc = array.get(lvlT, i)
            isSup = close > p
            col = isSup ? cSup : cRes
            w = tc >= majorN ? 3 : tc >= strongN ? 2 : 1
            stl = tc >= strongN ? line.style_solid : line.style_dashed
            array.push(lns, line.new(bar_index - 1, p, bar_index, p,
                 extend = extend.both, color = col, width = w, style = stl))

            tag = (isSup ? "S" : "R") + " x" + str.tostring(tc)
            tag := tc >= majorN ? tag + " MAJOR" : tc >= strongN ? tag + " STRONG" : tag
            if useMA and (math.abs(p - sma50) <= tol or math.abs(p - sma200) <= tol)
                tag := tag + " +MA"
            if useRound and isRound(p, tol)
                tag := tag + " +round"
            if useVol and array.get(lvlV, i)
                tag := tag + " +vol"
            // dark box + bright coloured text reads cleanly on any chart, and
            // sitting a few bars into the right margin keeps it off the candles
            array.push(lbs, label.new(bar_index + 4, p, tag, xloc = xloc.bar_index,
                 style = label.style_label_left,
                 color = color.new(color.black, 10), textcolor = col,
                 size = size.normal))

// ---- confluence MAs (global-scope plots) -----------------------------
plot(showMA ? sma50 : na, "MA 50", color.new(color.orange, 0), 1)
plot(showMA ? sma200 : na, "MA 200", color.new(color.blue, 0), 2)

// ---- alerts: price reaching a STRONG level ---------------------------
var float nearSup = na
var float nearRes = na
if barstate.islast
    nearSup := na
    nearRes := na
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            if array.get(lvlT, i) >= strongN
                p = array.get(lvlP, i)
                if p <= close and (na(nearSup) or p > nearSup)
                    nearSup := p
                if p >= close and (na(nearRes) or p < nearRes)
                    nearRes := p
alertcondition(not na(nearSup) and low <= nearSup, "Tagged strong support",
     "Price reached a strong support level")
alertcondition(not na(nearRes) and high >= nearRes, "Tagged strong resistance",
     "Price reached a strong resistance level")
