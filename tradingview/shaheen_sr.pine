//@version=5
// =====================================================================
// SHAHEEN  -  Support / Resistance + supply/demand zones by touch strength
// Paste into TradingView: Pine Editor -> paste -> Add to chart.
//
// Finds swing highs and lows, groups same-price swings into one LEVEL, and
// counts how many times price reversed there. More reversals = stronger.
// Each level is drawn as a line PLUS a shaded zone band (the "area"), because
// support/resistance is a zone, not a hairline.
//
//   green = support / demand   (at or below current price)
//   red   = resistance / supply (above current price)
//   width/style = strength: thin dashed (weak) -> thick solid (major)
//   label = "R x11 MAJOR +MA +round +vol"
//
// The +vol tag: at least one of the reversals at that level happened on a
// VOLUME SPIKE (>1.5x the 20-bar average). It means big players were active
// defending the level, not a quiet wick - a level bought/sold hard is more
// likely to hold again.
//
// No buy price is drawn - that formula is not trusted yet, on purpose.
// =====================================================================
indicator("Shaheen S/R + zones", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 400)

// ---- inputs ----------------------------------------------------------
grpD   = "Detection (lower = more levels)"
piv    = input.int(6, "Swing strength (bars each side)", minval = 2, group = grpD,
     tooltip = "Smaller finds more, smaller swings. 3-5 = busy, 8-12 = only majors")
tolMlt = input.float(0.5, "Merge tolerance (x ATR)", minval = 0.1, step = 0.1,
     group = grpD, tooltip = "Swings within this distance count as one level/zone")
minShow = input.int(1, "Min touches to draw a level", minval = 1, group = grpD)
maxShow = input.int(40, "Max levels to show", minval = 2, maxval = 80, group = grpD)
maxDistPct = input.float(35, "Only show levels within % of price", minval = 2,
     group = grpD, tooltip = "A trender like NVDA has its most-touched zones far below at old prices, which crowds out the resistance near today's price. This keeps levels near the current price so BOTH sides show.")
lblMin  = input.int(2, "Label a level from N touches", minval = 1, group = grpD,
     tooltip = "Weaker levels still get a line/zone, just no text, to cut clutter")

grpS   = "Strength tiers (touches = reversals)"
strongN = input.int(5,  "STRONG at N touches", minval = 2, group = grpS)
majorN  = input.int(11, "MAJOR at N touches",  minval = 3, group = grpS)

grpZ   = "Zones"
showZone = input.bool(true, "Shade the zone band", group = grpZ)

grpC   = "Confluences"
showMA   = input.bool(true, "Plot 50 / 200 MA", group = grpC)
useMA    = input.bool(true, "Tag levels near a 50/200 MA (+MA)", group = grpC)
useRound = input.bool(true, "Tag round-number levels (+round)", group = grpC)
useVol   = input.bool(true, "Tag levels tested on heavy volume (+vol)", group = grpC)

grpK   = "Colors"
cSup  = input.color(color.new(color.green, 0), "Support / demand", group = grpK)
cRes  = input.color(color.new(color.red, 0),   "Resistance / supply", group = grpK)
weakFade = input.int(55, "Weak-level fade %", minval = 0, maxval = 90, group = grpK,
     tooltip = "Weak levels keep their side colour (green/red) but faded this much, so weak resistance still reads as red")

// ---- per-bar context (must run every bar) ----------------------------
atr    = ta.atr(14)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
volAvg = ta.sma(volume, 20)

// ---- level store (persists across bars) ------------------------------
var float[] lvlP = array.new_float()      // price (running mean of touches)
var int[]   lvlT = array.new_int()        // touch / reversal count
var int[]   lvlB = array.new_int()        // bar of last touch
var int[]   lvlF = array.new_int()        // bar first seen
var bool[]  lvlV = array.new_bool()       // ever tested on heavy volume
var int[]   order = array.new_int()       // scratch for draw ordering

// merge a swing into a nearby level or create a new one. Self-contained:
// everything it needs is a parameter (no reaching into globals).
addTouch(pP, pT, pB, pF, pV, float p, bool heavy, float tol, int bidx) =>
    merged = false
    if array.size(pP) > 0
        for i = 0 to array.size(pP) - 1
            if math.abs(array.get(pP, i) - p) <= tol
                n = array.get(pT, i)
                array.set(pP, i, (array.get(pP, i) * n + p) / (n + 1))
                array.set(pT, i, n + 1)
                array.set(pB, i, bidx)
                if heavy
                    array.set(pV, i, true)
                merged := true
                break
    if not merged
        array.push(pP, p)
        array.push(pT, 1)
        array.push(pB, bidx)
        array.push(pF, bidx)
        array.push(pV, heavy)

prune(pP, pT, pB, pF, pV) =>
    while array.size(pP) > 120
        w = 0
        for i = 1 to array.size(pT) - 1
            if array.get(pT, i) < array.get(pT, w)
                w := i
        array.remove(pP, w)
        array.remove(pT, w)
        array.remove(pB, w)
        array.remove(pF, w)
        array.remove(pV, w)

isRound(float p, float tol) =>
    step = p < 10 ? 0.5 : p < 100 ? 5.0 : p < 1000 ? 10.0 : 50.0
    math.abs(p - math.round(p / step) * step) <= tol

// ranking score: rewards strength AND nearness to price, so the levels you can
// actually trade to (like a recent 212) beat an old, heavily-touched 164
scoreOf(int tc, float p, float cl) =>
    tc * 6.0 - (cl > 0 ? math.abs(p - cl) / cl * 100.0 : 0.0)

// ---- collect swings --------------------------------------------------
tol = atr * tolMlt
ph = ta.pivothigh(high, piv, piv)
pl = ta.pivotlow(low, piv, piv)
heavyNow = volume > volAvg * 1.5
if not na(ph)
    addTouch(lvlP, lvlT, lvlB, lvlF, lvlV, ph, heavyNow, tol, bar_index)
if not na(pl)
    addTouch(lvlP, lvlT, lvlB, lvlF, lvlV, pl, heavyNow, tol, bar_index)
prune(lvlP, lvlT, lvlB, lvlF, lvlV)

// ---- draw on the last bar (clean redraw) -----------------------------
var line[]  lns = array.new_line()
var label[] lbs = array.new_label()
var box[]   bxs = array.new_box()

if barstate.islast
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
    if array.size(bxs) > 0
        for i = 0 to array.size(bxs) - 1
            box.delete(array.get(bxs, i))
    array.clear(lns)
    array.clear(lbs)
    array.clear(bxs)

    // eligible: enough touches AND within maxDistPct of price
    array.clear(order)
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            p0 = array.get(lvlP, i)
            near = close > 0 and math.abs(p0 - close) / close * 100 <= maxDistPct
            if array.get(lvlT, i) >= minShow and near
                array.push(order, i)
    // sort by score (strength + nearness) desc
    if array.size(order) > 1
        for a = 1 to array.size(order) - 1
            key = array.get(order, a)
            ks = scoreOf(array.get(lvlT, key), array.get(lvlP, key), close)
            b = a - 1
            while b >= 0 and scoreOf(array.get(lvlT, array.get(order, b)), array.get(lvlP, array.get(order, b)), close) < ks
                array.set(order, b + 1, array.get(order, b))
                b := b - 1
            array.set(order, b + 1, key)

    // reserve up to half the slots for resistance so a dense support stack
    // can never crowd out the levels above price (the NVDA "no resistance" bug)
    resAvail = 0
    if array.size(order) > 0
        for j = 0 to array.size(order) - 1
            if close <= array.get(lvlP, array.get(order, j))
                resAvail := resAvail + 1
    resCap = math.min(maxShow / 2, resAvail)
    supCap = maxShow - resCap

    band = tol * 0.5
    resDrawn = 0
    supDrawn = 0
    if array.size(order) > 0
        for j = 0 to array.size(order) - 1
            i = array.get(order, j)
            p = array.get(lvlP, i)
            tc = array.get(lvlT, i)
            isSup = close > p
            okDraw = isSup ? supDrawn < supCap : resDrawn < resCap
            if okDraw
                if isSup
                    supDrawn := supDrawn + 1
                else
                    resDrawn := resDrawn + 1
                isStrong = tc >= strongN
                // side colour always (green support / red resistance); weak
                // levels are the same colour faded, so weak resistance stays red
                base = isSup ? cSup : cRes
                col = isStrong ? base : color.new(base, weakFade)
                w = tc >= majorN ? 3 : isStrong ? 2 : 1
                stl = isStrong ? line.style_solid : line.style_dashed

                array.push(lns, line.new(bar_index - 1, p, bar_index, p,
                     extend = extend.both, color = col, width = w, style = stl))

                if showZone
                    left = math.max(array.get(lvlF, i), bar_index - 300)
                    array.push(bxs, box.new(left, p + band, bar_index + 6, p - band,
                         border_color = color.new(base, 60),
                         bgcolor = color.new(base, 88)))

                // exact price on the right for every level; strong ones add tags
                pxTxt = str.tostring(p, format.mintick)
                txt = pxTxt
                if tc >= lblMin
                    tag = (isSup ? "S" : "R") + " x" + str.tostring(tc)
                    tag := tc >= majorN ? tag + " MAJOR" : tc >= strongN ? tag + " STRONG" : tag
                    if useMA and (math.abs(p - sma50) <= tol or math.abs(p - sma200) <= tol)
                        tag := tag + " +MA"
                    if useRound and isRound(p, tol)
                        tag := tag + " +round"
                    if useVol and array.get(lvlV, i)
                        tag := tag + " +vol"
                    txt := pxTxt + "  " + tag
                array.push(lbs, label.new(bar_index + 6, p, txt, xloc = xloc.bar_index,
                     style = label.style_label_left,
                     color = color.new(color.black, 10), textcolor = col,
                     size = isStrong ? size.normal : size.small))

// ---- confluence MAs --------------------------------------------------
plot(showMA ? sma50 : na, "MA 50", color.new(color.orange, 0), 1)
plot(showMA ? sma200 : na, "MA 200", color.new(color.blue, 0), 2)

// ---- alerts: price reaching a STRONG level ---------------------------
var float nearSup = na
var float nearRes = na
if barstate.islast
    nearSup := na
    nearRes := na
    if array.size(lvlP) > 0
        for i = 0 to array.size(lvlP) - 1
            if array.get(lvlT, i) >= strongN
                p = array.get(lvlP, i)
                if p <= close and (na(nearSup) or p > nearSup)
                    nearSup := p
                if p >= close and (na(nearRes) or p < nearRes)
                    nearRes := p
alertcondition(not na(nearSup) and low <= nearSup, "Tagged strong support",
     "Price reached a strong support level")
alertcondition(not na(nearRes) and high >= nearRes, "Tagged strong resistance",
     "Price reached a strong resistance level")
